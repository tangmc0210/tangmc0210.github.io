---
import Icon from "./Icon.astro";
import { research } from "../data/research";
---

<section id="research" class="border-y border-line bg-surface-2/30">
  <div class="mx-auto max-w-5xl px-5 py-20 sm:py-24">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">Research</p>
    <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      Methods I helped build
    </h2>
    <p class="mt-4 max-w-2xl text-muted">
      High-plex spatial transcriptomics technologies developed in the Huang Lab — turning standard
      microscopes into instruments that map RNA in tissue.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        research.map((r) => (
          <article class="group relative overflow-hidden rounded-2xl border border-line bg-surface p-7">
            <div
              class="absolute -right-16 -top-16 h-40 w-40 rounded-full opacity-25 blur-3xl transition-opacity group-hover:opacity-40"
              style={`background: var(${r.accent})`}
              aria-hidden="true"
            />
            <div class="relative">
              <h3 class="font-serif text-2xl font-semibold">{r.name}</h3>
              <p class="mt-1 text-sm text-faint">{r.full}</p>
              <p class="mt-4 leading-relaxed text-muted">{r.blurb}</p>
              <ul class="mt-5 space-y-2.5">
                {r.points.map((pt) => (
                  <li class="flex gap-3 text-sm">
                    <span
                      class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full"
                      style={`background: var(${r.accent})`}
                    />
                    <span class="text-muted">{pt}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-6 flex flex-wrap gap-4">
                {(r.links ?? []).map((l) => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-brand hover:underline"
                  >
                    {l.label}
                    <Icon name="external" class="h-3.5 w-3.5" />
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
