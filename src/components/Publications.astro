---
import Icon from "./Icon.astro";
import { publications, ME } from "../data/publications";
---

<section id="publications" class="mx-auto max-w-5xl px-5 py-20 sm:py-24">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">Publications</p>
  <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
    Selected publications
  </h2>
  <ol class="mt-10 space-y-9">
    {
      publications.map((p) => (
        <li class="grid gap-3 sm:grid-cols-[8rem_1fr] sm:gap-6">
          <div class="flex flex-wrap items-center gap-2 sm:flex-col sm:items-end sm:gap-1.5 sm:text-right">
            <span class="rounded-md bg-brand-soft px-2 py-1 text-xs font-semibold text-brand">
              {p.venue}
            </span>
            <span class="font-mono text-sm text-faint">{p.year}</span>
            {p.isPreprint && (
              <span class="rounded-md border border-line px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-faint">
                Preprint
              </span>
            )}
          </div>
          <div>
            <h3 class="font-serif text-lg font-medium leading-snug">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              {p.authors.map((a, idx) => (
                <span>
                  <span class={a === ME ? "font-semibold text-ink" : ""}>{a}</span>
                  {idx < p.authors.length - 1 ? ", " : ""}
                </span>
              ))}
            </p>
            {p.contribution && (
              <p class="mt-1.5 text-xs font-medium text-brand">{p.contribution}</p>
            )}
            <div class="mt-3 flex flex-wrap items-center gap-4 text-sm">
              {p.doi && (
                <a
                  href={`https://doi.org/${p.doi}`}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 font-medium text-brand hover:underline"
                >
                  DOI
                  <Icon name="external" class="h-3.5 w-3.5" />
                </a>
              )}
              {p.preprintLink && (
                <a
                  href={p.preprintLink.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 text-muted hover:text-ink"
                >
                  {p.preprintLink.label}
                  <Icon name="external" class="h-3.5 w-3.5" />
                </a>
              )}
            </div>
            {p.tags && (
              <div class="mt-3 flex flex-wrap gap-2">
                {p.tags.map((t) => (
                  <span class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-muted">{t}</span>
                ))}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
