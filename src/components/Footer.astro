---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-5 py-8 text-sm text-faint sm:flex-row"
  >
    <p>© {year} {site.name} · {site.affiliation}</p>
    <p>
      Built with
      <a href="https://astro.build" target="_blank" rel="noopener" class="hover:text-ink">Astro</a>
      &amp; Tailwind CSS
    </p>
  </div>
</footer>
